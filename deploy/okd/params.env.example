IMAGE=ghcr.io/als0m3/custom-remote:latest
API_HOST=relay-api.apps.cluster.example.test
CHAT_HOST=relay.apps.cluster.example.test
PUBLIC_API_HOST=relay-api.example.test
PUBLIC_CHAT_HOST=relay.example.test
OIDC_ISSUER=https://keycloak.example.test/auth/realms/REALM
OIDC_CLIENT_ID=relay
OIDC_PROVIDER_NAME=Example
ADMIN_EMAILS=admin@example.test
ADMIN_GROUPS=
ACCESS_ROLE=relay_access
ADMIN_ROLE=relay_admin
ROLES_CLAIM=roles
DEFAULT_MODEL=sonnet
TASK_MODEL=haiku
# Settings outside the template, read by deploy.sh:
NETBIRD_ROUTE=true
CERT_ISSUER=
